FOCUS_PS1 = r'''# Tatami Room: bring up the window of the WSL session this runs in. `tatami window` starts it
# inside an agent's session, so its parent is that session's wsl.exe, whose console the agent
# shares. The console belongs to the agent's window (Windows Terminal's, or any other), however
# that window was opened. Exit 0: in front. 1: shown, but Windows kept the focus elsewhere (the
# title goes to the file given, for open.vbs). 2: this session has no window of its own.
# With -Find it only prints the window's handle, for the agent to keep (the Tatami Room app then
# brings it up by that handle, without going through WSL).
param([string]$TitleFile, [switch]$Find)
Add-Type @"
using System; using System.Text; using System.Runtime.InteropServices;
public class TatamiWindow {
  [DllImport("kernel32.dll")] static extern bool AttachConsole(uint pid);
  [DllImport("kernel32.dll")] static extern bool FreeConsole();
  [DllImport("kernel32.dll")] static extern IntPtr GetConsoleWindow();
  [DllImport("kernel32.dll")] static extern uint GetCurrentThreadId();
  [DllImport("user32.dll")] static extern IntPtr GetAncestor(IntPtr h, uint f);
  [DllImport("user32.dll")] static extern bool IsWindowVisible(IntPtr h);
  [DllImport("user32.dll")] static extern bool IsIconic(IntPtr h);
  [DllImport("user32.dll")] static extern bool ShowWindow(IntPtr h, int n);
  [DllImport("user32.dll")] static extern IntPtr GetForegroundWindow();
  [DllImport("user32.dll")] static extern uint GetWindowThreadProcessId(IntPtr h, IntPtr pid);
  [DllImport("user32.dll")] static extern bool AttachThreadInput(uint a, uint b, bool attach);
  [DllImport("user32.dll")] static extern bool BringWindowToTop(IntPtr h);
  [DllImport("user32.dll")] static extern bool SetForegroundWindow(IntPtr h);
  [DllImport("user32.dll", CharSet = CharSet.Unicode)] static extern int GetWindowText(IntPtr h, StringBuilder s, int n);
  public static string Title = "";
  public static IntPtr Find() {
    FreeConsole();
    if (!AttachConsole(0xFFFFFFFF)) return IntPtr.Zero;   // the parent's console, which is the agent's
    IntPtr console = GetConsoleWindow();
    FreeConsole();
    IntPtr w = GetAncestor(console, 3);         // its root owner: the window the agent lives in
    return w != IntPtr.Zero && IsWindowVisible(w) ? w : IntPtr.Zero;
  }
  public static int Focus() {
    IntPtr w = Find();
    if (w == IntPtr.Zero) return 2;
    var s = new StringBuilder(512);
    GetWindowText(w, s, 512);
    Title = s.ToString();
    if (IsIconic(w)) ShowWindow(w, 9);          // restore it if it's minimized
    uint front = GetWindowThreadProcessId(GetForegroundWindow(), IntPtr.Zero), me = GetCurrentThreadId();
    AttachThreadInput(front, me, true);         // sharing input with the window in front lets
    BringWindowToTop(w);                        // us hand the focus over
    SetForegroundWindow(w);
    AttachThreadInput(front, me, false);
    return GetForegroundWindow() == w ? 0 : 1;
  }
}
"@
if ($Find) {
  $w = [TatamiWindow]::Find()
  if ($w -eq [IntPtr]::Zero) { exit 2 }
  [Console]::Out.WriteLine($w.ToInt64())
  exit 0
}
$rc = [TatamiWindow]::Focus()
if ($TitleFile -and [TatamiWindow]::Title) { Set-Content -Path $TitleFile -Value ([TatamiWindow]::Title) -Encoding Unicode }
exit $rc
'''
