def waifu_path():
    """How Windows calls waifu: through the ~/.local/bin link when there is one, so moving the
    repo folder (and re-linking) can't strand the shortcut."""
    link, me = os.path.expanduser("~/.local/bin/waifu"), os.path.realpath(__file__)
    return link if os.path.realpath(link) == me else me


def tatami_path():
    """Tatami Room's desk command, if it's set up (linked in ~/.local/bin like waifu)."""
    link = os.path.expanduser("~/.local/bin/tatami")
    return link if os.path.exists(link) else None


def write_launcher():
    """The scripts the shortcuts run. Rewritten whenever they're out of date, e.g. after the
    repo moved: a launcher that can't find waifu opens every window on the same slot."""
    tatami = tatami_path()
    desk = DESK_AUTOSTART.format(distro=DISTRO, tatami=tatami) if tatami else ""
    scripts = {"launch.vbs": LAUNCH_VBS.format(distro=DISTRO, waifu=waifu_path(), desk=desk, slots=SLOTS)}
    if tatami:
        scripts["desk.vbs"] = DESK_VBS.format(distro=DISTRO, tatami=tatami, browser=CONF.get("browser", ""),
                                              app=win_path(os.path.join(app_dir(), APP_EXE)))
        scripts["desk-open.ps1"] = DESK_OPEN_PS1
        scripts["open.vbs"] = OPEN_VBS.format(distro=DISTRO, tatami=tatami)
        scripts["focus-window.ps1"] = FOCUS_PS1
    for name, text in scripts.items():
        path = os.path.join(LAUNCHER_DIR, name)
        try:
            with open(path, encoding="utf-8-sig") as f:
                if f.read() == text:
                    continue
        except (OSError, UnicodeDecodeError):
            pass
        # PowerShell reads a script without a byte order mark as the old ANSI code page
        with open(path, "w", newline="\r\n", encoding="utf-8-sig" if name.endswith(".ps1") else None) as f:
            f.write(text)
    if tatami:
        sync_app()


def app_dir():
    """Where the Tatami Room app lives: %LOCALAPPDATA%\\TatamiRoom, next to waifu's launchers."""
    return os.path.join(os.path.dirname(LAUNCHER_DIR), "TatamiRoom")


def install_app():
    """Tatami Room as a Windows app: Electron's runtime around the desk, with the app's own code
    from this repo. The runtime is downloaded once and checked against Electron's checksum."""
    base = app_dir()
    if not os.path.exists(os.path.join(base, APP_EXE)):
        version, digest = ELECTRON
        name = f"electron-{version}-win32-x64.zip"
        part = os.path.join(LAUNCHER_DIR, name)
        print(f"app: downloading Electron {version}, the app's runtime (about 160 MB)...")
        sha = hashlib.sha256()
        req = urllib.request.Request(f"https://github.com/electron/electron/releases/download/{version}/{name}",
                                     headers={"User-Agent": "tatami-room/1.0"})
        try:
            with urllib.request.urlopen(req, timeout=120) as r, open(part, "wb") as f:
                for chunk in iter(lambda: r.read(1 << 20), b""):
                    sha.update(chunk)
                    f.write(chunk)
        except OSError as e:
            print(f"app: download failed ({e}); the desk opens in your browser instead")
            return
        if sha.hexdigest() != digest:
            os.remove(part)
            print("app: the download didn't match Electron's published checksum, so it wasn't installed")
            return
        os.makedirs(base, exist_ok=True)
        windows("tar.exe", "-xf", win_path(part), "-C", win_path(base))  # Windows' own unzip is quick
        os.remove(part)
        os.replace(os.path.join(base, "electron.exe"), os.path.join(base, APP_EXE))
        default = os.path.join(base, "resources", "default_app.asar")  # Electron's demo app
        if os.path.exists(default):
            os.remove(default)
    sync_app()


def mark_icon():
    """tatami.ico, the app's and the shortcuts' icon, redrawn when the mark has changed since it was drawn."""
    icon = os.path.join(LAUNCHER_DIR, "tatami.ico")
    drawn = icon + ".mark"   # which drawing it holds
    try:
        with open(drawn) as f:
            if f.read() == repr(MARK) and os.path.exists(icon):
                return icon
    except OSError:
        pass
    with_pillow("_mark", icon + ".new")
    if os.path.exists(icon + ".new"):   # not if Pillow couldn't be had: then the old one stays, to retry next time
        os.replace(icon + ".new", icon)
        with open(drawn, "w") as f:
            f.write(repr(MARK))
    return icon


def sync_app():
    """Put the app's code from this repo into the installed app, when it changed. waifu hello runs
    this, so `git pull` updates the app like everything else (it applies when the app restarts)."""
    if not os.path.exists(os.path.join(app_dir(), APP_EXE)):
        return
    dst = os.path.join(app_dir(), "resources", "app")
    os.makedirs(dst, exist_ok=True)
    files = {}
    for name in APP_FILES:
        with open(os.path.join(os.path.dirname(os.path.realpath(__file__)), "app", name), "rb") as f:
            files[name] = f.read()
    files["config.json"] = json.dumps({"distro": DISTRO, "tatami": tatami_path(),
                                       "launcher": win_path(LAUNCHER_DIR)}, indent=2).encode()
    icon = mark_icon()
    if os.path.exists(icon):
        with open(icon, "rb") as f:
            files["tatami.ico"] = f.read()
    for name, data in files.items():
        path = os.path.join(dst, name)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        try:
            with open(path, "rb") as f:
                if f.read() == data:
                    continue
        except OSError:
            pass
        with open(path, "wb") as f:
            f.write(data)


def win_path(p):
    """/mnt/d/TerminalGirls/x.png -> D:\\TerminalGirls\\x.png"""
    if p.startswith("/mnt/") and len(p) > 6 and p[6] == "/":
        return p[5].upper() + ":\\" + p[7:].replace("/", "\\")
    return subprocess.run(["wslpath", "-w", p], capture_output=True, text=True).stdout.strip()


